{
  "name": "sidebar",
  "version": "1.1.3",
  "description": "SideBar desktop sidebar for Windows.",
  "main": "./out/main/index.js",
  "author": "Codex",
  "license": "MIT",
  "repository": "https://github.com/Asulerrr/SiderbarPlus.git",
  "scripts": {
    "dev": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-log": "^5.2.0",
    "koffi": "^2.16.1",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.0.0",
    "sharp": "^0.34.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/auto-launch": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.36.0",
    "globals": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
